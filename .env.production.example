# Copy to .env on the VM, next to docker-compose.prod.yml — Docker Compose
# reads it automatically. NEVER commit the real file (already in
# .gitignore). chmod 600 it once populated.

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Leave both IdP blocks empty for an initial plumbing smoke test (the
# container will boot and /api/health will work; sign-in will not — see
# infra/deploy/README.md "What still needs real values"). Fill in once
# you've registered the app with Entra ID / Google.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
