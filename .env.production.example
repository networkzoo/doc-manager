# Copy to .env on the VM, next to docker-compose.prod.yml — Docker Compose
# reads it automatically. NEVER commit the real file (already in
# .gitignore). chmod 600 it once populated.

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# The app's actual runtime DB role — NOT the same as POSTGRES_PASSWORD
# above, which is law_portal (the owner/superuser role: migrations,
# seeding, cross-tenant admin tooling only — see packages/db/src/client.ts
# and infra/deploy/README.md "Least-privilege app database role"). This
# is law_portal_app, the non-superuser role RLS is actually enforced for.
# drizzle/0001_rls_policies.sql creates that role with a literal
# placeholder password ('change_me_in_deploy_secrets') — you MUST rotate
# it (see the README section above) before this is safe to leave running.
# Generate the real password with: openssl rand -base64 24, then:
# postgres://law_portal_app:<that password>@db:5432/law_portal
APP_DATABASE_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Leave both IdP blocks empty for an initial plumbing smoke test (the
# container will boot and /api/health will work; sign-in will not — see
# infra/deploy/README.md "What still needs real values"). Fill in once
# you've registered the app with Entra ID / Google.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed onto /admin/tenants (creating new firms
# on the platform) — deliberately NOT the same as a tenant's own "admin"
# role, see apps/portal/src/lib/platformAdmin.ts. Leave empty to disable
# the page for everyone.
PLATFORM_ADMIN_EMAILS=

# Caddy + ClouDNS (see infra/deploy/README.md "TLS via Caddy + ClouDNS").
# The hostname you're pointing at this VM, e.g. portal.yourdomain.com —
# doesn't need to resolve publicly, just from wherever you'll access it
# (LAN / Netbird).
PORTAL_DOMAIN=

# From your ClouDNS account: Control Panel -> API Access for a full
# auth_id + password, or -> Sub-Users if you'd rather scope it to a
# sub-account. Only one of CLOUDNS_AUTH_ID / CLOUDNS_SUB_AUTH_ID is
# needed — set whichever you generated, leave the other blank.
CLOUDNS_AUTH_ID=
CLOUDNS_SUB_AUTH_ID=
CLOUDNS_AUTH_PASSWORD=

# Self-hosted relay store (see infra/deploy/README.md "Relay store:
# MinIO"). A second hostname/subdomain, e.g. relay.yourdomain.com —
# separate from PORTAL_DOMAIN since it's a different service.
RELAY_DOMAIN=

# MinIO's admin/bootstrap credentials — used once to create the relay
# bucket and a separate, scoped access key (below). The app itself never
# uses these directly. Generate with: openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# The scoped credentials the portal actually uses to presign PUT/GET
# URLs — created via the setup steps in infra/deploy/README.md, NOT the
# same as MINIO_ROOT_USER/PASSWORD above. Least-privilege: this key can
# only touch the one relay bucket.
RELAY_ACCESS_KEY_ID=
RELAY_SECRET_ACCESS_KEY=
RELAY_BUCKET=law-portal-relay

# A second scoped key (list + delete only, no put/get) for the
# relay-cleanup sweep that deletes blobs older than 1h — see
# infra/deploy/README.md "Relay store: MinIO". Deliberately separate
# from RELAY_ACCESS_KEY_ID/SECRET above so the app's own key never gains
# delete rights.
RELAY_CLEANUP_ACCESS_KEY_ID=
RELAY_CLEANUP_SECRET_ACCESS_KEY=
