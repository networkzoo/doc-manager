# {$PORTAL_DOMAIN} comes from the caddy service's environment in
# docker-compose.prod.yml (sourced from .env). `dns cloudns` picks up
# CLOUDNS_AUTH_ID / CLOUDNS_SUB_AUTH_ID / CLOUDNS_AUTH_PASSWORD from the
# environment automatically — no credentials live in this file.
#
# DNS-01 means Let's Encrypt validates ownership through a DNS record
# ClouDNS's API lets Caddy create/remove itself — this VM never needs to
# be reachable from the public internet for certs to issue or renew.

{$PORTAL_DOMAIN} {
	tls {
		dns cloudns
		# ClouDNS runs several authoritative nameservers, and a freshly
		# API-created record has genuinely taken 30-45s to propagate
		# across all of them in practice (confirmed via a staging-CA test
		# issuance) — without a delay, Caddy's own check (and then Let's
		# Encrypt's) can hit NXDOMAIN against a server that hasn't caught
		# up yet, even though the record exists. Wait before checking at
		# all, then allow a generous window for slower propagation.
		propagation_delay 45s
		propagation_timeout 5m
	}

	reverse_proxy portal:3000
}

# Self-hosted relay store (docs/PLAN.md "Tunnel-free file flow") — MinIO's
# S3 API only, not its console (port 9001, deliberately not exposed here).
# LAN-only for now (an internal-only A record, same as {$PORTAL_DOMAIN}),
# same as the portal — goes properly internet-facing only once a real
# remote client's connector needs to reach it.
{$RELAY_DOMAIN} {
	tls {
		dns cloudns
		propagation_delay 45s
		propagation_timeout 5m
	}

	reverse_proxy minio:9000
}
