# Copy to .env.local for development. Never commit the real .env.local —
# it's already in .gitignore.

# Postgres (matches docker-compose.yml default; override for a real box)
DATABASE_URL=postgres://law_portal:dev_only_password@localhost:5432/law_portal

# Auth.js — required in production; leave unset in dev to use the fixed
# dev session (see src/lib/session.ts).
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
